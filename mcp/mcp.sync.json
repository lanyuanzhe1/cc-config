{
  "playwright": {
    "command": "npx",
    "args": [
      "@playwright/mcp@latest",
      "--browser",
      "firefox"
    ],
    "platforms": [
      "mac"
    ]
  },
  "mcp-vision": {
    "command": "{{PYTHON}}",
    "args": [
      "-m",
      "mcp_ocr.server"
    ],
    "env": {
      "PATH": "/opt/homebrew/Caskroom/miniconda/base/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin",
      "MCP_OCR_PROVIDER": "siliconflow",
      "SILICONFLOW_API_KEY": "sk-blqqsunnbwavajlexwscanzbmedwaeqoqocngbrbtsmlqsgt",
      "SILICONFLOW_MODEL": "deepseek-ai/DeepSeek-OCR"
    },
    "platforms": [
      "mac"
    ]
  },
  "mimo-vision": {
    "command": "{{PYTHON}}",
    "args": [
      "/Users/lanyuanzhe/mcp-mimo-vision/server.py"
    ],
    "env": {
      "MIMO_API_KEY": "sk-cz0yl9kfa3qxzugeodcwsqwk04lk3k43yr0f66g8mt44f70c",
      "MIMO_MODEL": "mimo-v2.5"
    },
    "platforms": [
      "mac"
    ]
  },
  "hermes": {
    "type": "http",
    "url": "https://mcp.hermesagent.org.cn/v1",
    "platforms": [
      "mac"
    ]
  }
}